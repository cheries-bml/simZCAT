      "options": {
        "A": {
          "text": "has"
        },
        "B": {
          "text": "had",
          "correct": true
        },
        "C": {
          "text": "have had"
        },
        "D": {
          "text": "will have"
        }
      },
      "explanation": {
        "text": "An unreal or unlikely present situation uses <b>if + past simple</b>, then <b>would + base verb</b>.",
        "topic": "Conditionals",
        "concept": "Second conditional",
        "formula": "If + past simple, would + verb",
        "examples": [
          "If I <b>won</b> the lottery, I would travel."
        ]

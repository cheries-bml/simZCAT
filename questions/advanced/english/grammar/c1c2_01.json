        "C": {
          "text": "Scarcely",
          "correct": false
        },
        "D": {
          "text": "Rarely",
          "correct": false
        }
      },
      "explanation": {
        "text": "'No sooner' is strictly paired with 'than' to indicate that one event happened immediately after another. 'Hardly' and 'Scarcely' are paired with 'when'.",
        "topic": "Inversion",
        "concept": "Negative Adverbial Inversion",
        "formula": "No sooner + had + subject + past participle + than + clause",
        "examples": [
          "No sooner <b>had</b> I arrived <b>than</b> it started raining."
        ]
      },
      "config": {

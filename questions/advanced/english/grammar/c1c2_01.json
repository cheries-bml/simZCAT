      "type": "multiple_choice",
      "data": {
        "hint": "Choose the correct option to complete the sentence.",
        "question": "_____ had he arrived at the office than the phone started ringing."
      },
      "options": {
        "A": {
          "text": "No sooner",
          "correct": true
        },
        "B": {
          "text": "Hardly",
          "correct": false
